# 文心 AI Studio Access Token
BAIDU_ACCESS_TOKEN=""

# 文心 OpenAI 兼容接口配置
ERNIE_BASE_URL="https://aistudio.baidu.com/llm/lmapi/v3"

# 留空时自动使用 ERNIE_BASE_URL + /chat/completions
ERNIE_CHAT_ENDPOINT=""

# 模型名称
ERNIE_MODEL="ernie-5.0-thinking-preview"

# 是否启用联网搜索
ERNIE_WEB_SEARCH_ENABLED="true"

# 全局热键，可按需修改
HOTKEY="ctrl+alt+q"

# 是否启用全局热键
HOTKEY_ENABLED="false"

# OCR 模式：
# local = 使用本地 PaddleOCR
# api   = 使用 PaddleOCR API
OCR_BACKEND="api"

# 只有当 OCR_BACKEND=api 时才会使用
PADDLEOCR_API_URL="https://你的-aistudio-app/layout-parsing"
PADDLEOCR_TOKEN=""

# 网络请求超时时间，单位秒
REQUEST_TIMEOUT="60"
